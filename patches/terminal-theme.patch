diff --git a/codex-rs/tui/src/tui/terminal_colors.rs b/codex-rs/tui/src/tui/terminal_colors.rs
new file mode 100644
index 0000000000..f319291a4a
--- /dev/null
+++ b/codex-rs/tui/src/tui/terminal_colors.rs
@@ -0,0 +1,99 @@
+//! Refresh terminal defaults through the ordinary event stream, without another stdin reader.
+
+use crate::terminal_probe::DefaultColors;
+use std::io::Write;
+
+pub(super) fn subscribe() {
+    write_sequence(b"\x1b[?2031h\x1b[?996n");
+}
+
+pub(super) fn unsubscribe() {
+    write_sequence(b"\x1b[?2031l");
+}
+
+fn write_sequence(sequence: &[u8]) -> bool {
+    let mut stdout = std::io::stdout().lock();
+    stdout
+        .write_all(sequence)
+        .and_then(|()| stdout.flush())
+        .is_ok()
+}
+
+#[derive(Default)]
+pub(super) struct PaletteRefresh {
+    pending: bool,
+    foreground: Option<(u8, u8, u8)>,
+    background: Option<(u8, u8, u8)>,
+}
+
+impl PaletteRefresh {
+    pub(super) fn request(&mut self) {
+        self.cancel();
+        self.pending = write_sequence(b"\x1b]10;?\x1b\\\x1b]11;?\x1b\\");
+    }
+
+    pub(super) fn cancel(&mut self) {
+        *self = Self::default();
+    }
+
+    pub(super) fn observe(&mut self, slot: u8, rgb: Option<(u8, u8, u8)>) -> Option<DefaultColors> {
+        if !self.pending {
+            return None;
+        }
+        match slot {
+            10 => self.foreground = rgb,
+            11 => self.background = rgb,
+            _ => return None,
+        }
+        let colors = DefaultColors {
+            fg: self.foreground?,
+            bg: self.background?,
+        };
+        self.cancel();
+        Some(colors)
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn waits_for_a_complete_pair_in_either_order() {
+        for order in [[10, 11], [11, 10]] {
+            let mut refresh = PaletteRefresh {
+                pending: true,
+                ..Default::default()
+            };
+            assert_eq!(refresh.observe(order[0], Some((220, 220, 220))), None);
+            assert_eq!(
+                refresh.observe(order[1], Some((0, 0, 0))),
+                Some(DefaultColors {
+                    fg: if order[0] == 10 {
+                        (220, 220, 220)
+                    } else {
+                        (0, 0, 0)
+                    },
+                    bg: if order[0] == 11 {
+                        (220, 220, 220)
+                    } else {
+                        (0, 0, 0)
+                    },
+                })
+            );
+            assert_eq!(refresh.observe(10, Some((255, 255, 255))), None);
+        }
+    }
+
+    #[test]
+    fn cancellation_and_invalid_replies_never_publish_a_partial_palette() {
+        let mut refresh = PaletteRefresh {
+            pending: true,
+            ..Default::default()
+        };
+        assert_eq!(refresh.observe(10, Some((0, 0, 0))), None);
+        assert_eq!(refresh.observe(11, None), None);
+        refresh.cancel();
+        assert_eq!(refresh.observe(11, Some((220, 220, 220))), None);
+    }
+}
